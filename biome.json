{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!.next",
			"!out",
			"!build",
			"!next-env.d.ts",
			"!**/*.css",
			"!src/components/ui"
		]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"enabled": true,
		"domains": {
			"next": "recommended",
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noArrayIndexKey": "off",
				"useIterableCallbackReturn": "off"
			},
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useAriaPropsSupportedByRole": "off"
			}
		}
	}
}
